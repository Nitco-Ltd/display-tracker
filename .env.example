# Copy this file to ".env" and fill in the blanks (the lines ending in =).
# Never share or commit .env: it holds passwords.

# --- Database ---
# Local (default): a SQLite file in the data folder.
DATABASE_URL=file:./data/app.db
# Company server / Vercel: change only this line to a Postgres address, e.g.
# DATABASE_URL=postgres://user:password@host:5432/display_tracker

# --- NITCO RMI (https://rmi.nitco.in) ---
# Use an account that can see ALL zones.
RMI_USER=
RMI_PASS=
# The RMI web app's built-in key (same for everyone). It is in the RMI login page's JavaScript ("Authtoken").
RMI_APP_KEY=

# --- SAP S/4HANA, read-only (docs/sap-api.md) ---
# NITCO production S4 PRD (PS4). Reachable only from the office network or VPN.
SAP_ODATA_BASE_URL=https://192.168.81.61:44300/sap/opu/odata/sap/
SAP_CLIENT=100
SAP_USER=
SAP_PASS=
# SAP's https certificate is self-signed: the app trusts exactly this certificate and checks its name.
SAP_TLS_CA_FILE=./certs/sap-prd.pem
SAP_TLS_SERVERNAME=vhntops4ci.sap.nitco.in
# Sales rules (confirmed 24 Nov 2026, docs/sap-api.md section 6)
SAP_SALES_ORGS=1801
SAP_SALES_DOC_TYPES=ZVDT
SAP_RETURN_DOC_TYPES=ZRTI
SAP_VALUE_ONLY_DOC_TYPES=ZCBR,ZCPD,ZCQC
# Undecided types, kept apart: reports come in two versions, without (default) and with these
SAP_EXTRA_DOC_TYPES=ZNTI,ZDMS
SAP_EXTRA_VALUE_ONLY_DOC_TYPES=ZTDN
SAP_FIRST_BILLING_DATE=2025-03-01
SAP_RECHECK_MONTHS=3
SAP_VOLUME_UNIT=M2
# Only for testing against SAP's public demo system (api.sap.com). Leave blank.
SAP_API_KEY=

# --- Output ---
# Where the daily job saves the monthly Excel reports (e.g. a OneDrive-synced folder):
# REPORT_OUTPUT_DIR=C:\Users\<you>\OneDrive - NITCO\Display Tracker Reports
REPORT_OUTPUT_DIR=./reports
LOG_DIR=./logs

# --- Optional: email when the daily job fails (leave SMTP_HOST blank to switch off) ---
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
