# Copy this file to ".env" and fill in the blanks. Never commit .env.

# --- Database ---
# Local (default): SQLite file in ./data
DATABASE_URL=file:./data/app.db
# Company server / Vercel: just change to a Postgres URL, e.g.
# DATABASE_URL=postgres://user:password@host:5432/display_tracker

# --- NITCO RMI (https://rmi.nitco.in) ---
# Use an account that can see ALL zones (admin). Zonal accounts only see their zone.
RMI_USER=
RMI_PASS=
# The web app's static key. It is visible in the RMI login page's JavaScript ("Authtoken" header).
RMI_APP_KEY=

# --- SAP S/4HANA OData (read-only) --- see docs/sap-api.md
# Base of the OData gateway, ending in /sap/opu/odata/sap/
SAP_ODATA_BASE_URL=
SAP_CLIENT=
SAP_USER=
SAP_PASS=
# Comma-separated sales organisations to include (blank = all)
SAP_SALES_ORGS=
# Billing document types — TO BE CONFIRMED by the SAP team
SAP_SALES_DOC_TYPES=F2
SAP_RETURN_DOC_TYPES=RE,G2
SAP_FIRST_BILLING_DATE=2025-03-01
SAP_RECHECK_MONTHS=3
SAP_VOLUME_UNIT=M2

# --- Output ---
# Where generated Excel reports are saved (e.g. a OneDrive-synced folder)
REPORT_OUTPUT_DIR=./reports
